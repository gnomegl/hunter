format_leads() {
  local response="$1"
  local count=$(echo "$response" | jq -r '.data.leads | length')
  local total=$(echo "$response" | jq -r '.data.meta.results')

  printf "${bold}Leads:${reset} ${green}%s${reset} of ${yellow}%s${reset} total\n\n" "$count" "$total"

  echo "$response" | jq -r '.data.leads[] | "\(.first_name)|\(.last_name)|\(.email)|\(.position // "N/A")|\(.company // "N/A")|\(.confidence_score)|\(.created_at)|\(.sources | length // 0)"' |
    while IFS="|" read -r first last email position company score date sources_count; do
      date_formatted=$(date -d "${date}" "+%Y-%m-%d" 2>/dev/null || date -j -f "%Y-%m-%dT%H:%M:%SZ" "${date}" "+%Y-%m-%d" 2>/dev/null)
      printf "${bold}* ${green}%s %s${reset} <${blue}%s${reset}> (${yellow}%s%%${reset})\n" "$first" "$last" "$email" "$score"
      [ "$position" != "N/A" ] && printf "  ${cyan}Position:${reset} ${magenta}%s${reset}\n" "$position"
      [ "$company" != "N/A" ] && printf "  ${cyan}Company:${reset} ${magenta}%s${reset}\n" "$company"
      printf "  ${cyan}Added:${reset} ${yellow}%s${reset}\n" "$date_formatted"
      
      if [ "$sources_count" -gt 0 ] && [ "$sources_count" != "null" ]; then
        printf "  ${cyan}Sources:${reset}\n"
        jq_query='.data.leads[] | select(.email == "'"$email"'") | .sources[] | "\(.domain)|\(.uri)|\(.extracted_on)|\(.still_on_page // empty)"'
        echo "$response" | jq -r "$jq_query" |
          while IFS="|" read -r domain uri extracted still_on_page; do
            printf "    ${yellow}%s${reset} - ${blue}%s${reset} (${magenta}%s${reset})" "$domain" "$uri" "$extracted"
            if [ "$still_on_page" = "true" ]; then
              printf " ${green}✓${reset}"
            elif [ "$still_on_page" = "false" ]; then
              printf " ${red}✗${reset}"
            fi
            printf "\n"
          done
      fi
      
      printf "\n"
    done
}

