    echo "  ${cyan}email-finder${reset}  Find email address by name and domain/company"
    echo "  ${cyan}verify${reset}        Verify an email address"
    echo "  ${cyan}count${reset}         Get email count for a domain"
    echo "  ${cyan}account${reset}       Show account information"
    echo "  ${cyan}leads${reset}         List leads"
    echo "  ${cyan}person${reset}        Find detailed information about a person by email"
    echo "  ${cyan}combined${reset}      Find detailed information about a person and their company"
    echo ""
    echo "${bold}Examples:${reset}"
    echo "  ${green}$(basename "$0") domain example.com${reset}"
    echo "  ${green}$(basename "$0") email-finder --first-name John --last-name Doe --domain example.com${reset}"
    echo "  ${green}$(basename "$0") verify john.doe@example.com${reset}"
    echo "  ${green}$(basename "$0") count example.com${reset}"
    echo "  ${green}$(basename "$0") account${reset}"
    echo "  ${green}$(basename "$0") leads${reset}"
    echo "  ${green}$(basename "$0") person john.doe@example.com${reset}"
    echo "  ${green}$(basename "$0") combined john.doe@example.com${reset}"
    echo ""
    echo "${bold}Common Options:${reset}"
