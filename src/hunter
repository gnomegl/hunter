#!/usr/bin/env bash

# @describe Hunter.io API client for email intelligence
# @arg command "Command to run (domain, email-finder, verify, count, account, leads, person, combined, help)" [string]
# @arg value "Value to search for (domain name, email address, etc.) or command name for help" [string]
# @option -k --key "Hunter.io API key (can also use HUNTER_API_KEY env var)" [string]
# @option -f --first-name "First name for email-finder (email-finder only)" [string]
# @option -l --last-name "Last name for email-finder (email-finder only)" [string]
# @option -c --company "Company name for email-finder (email-finder only)" [string]
# @option -d --domain "Domain name (alternative to providing as value)" [string]
# @option -p --page "Page number for results pagination (domain, leads)" [int] @default "1"
# @option -s --size "Number of results per page (domain, leads)" [int] @default "100"
# @option -t --type "Filter by email type: personal or generic (domain only)" [string]
# @option -e --department "Filter by department: it, finance, management, sales, etc. (domain only)" [string]
# @option -n --seniority "Filter by seniority: junior, senior, executive, etc. (domain only)" [string]
# @flag   -j --json "Output raw JSON instead of formatted results"
# @flag   -q --quiet "Suppress colored output"
# @meta require-tools curl,jq

eval "$(argc --argc-eval "$0" "$@")"

setup_colors() {
  if [ "$argc_quiet" = 1 ] || [ -z "$TERM" ] || [ "$TERM" = "dumb" ]; then
    bold="" reset="" blue="" green="" yellow="" cyan="" magenta="" red=""
  else
    bold=$(tput bold) reset=$(tput sgr0) blue=$(tput setaf 4) green=$(tput setaf 2)
    yellow=$(tput setaf 3) cyan=$(tput setaf 6) magenta=$(tput setaf 5) red=$(tput setaf 1)
  fi
}
setup_colors

get_api_key() {
  local key=""

  if [ -n "$argc_key" ]; then
    key="$argc_key"
  elif [ -n "$HUNTER_API_KEY" ]; then
    key="$HUNTER_API_KEY"
  elif [ -f "$HOME/.config/hunter/api_key" ]; then
    key=$(cat "$HOME/.config/hunter/api_key")
  fi

  if [ -n "$key" ]; then
    echo "$key"
  else
    printf "${red}Error:${reset} No Hunter.io API key found.\n" >&2
    printf "Please provide your API key using one of these methods:\n" >&2
    printf "  1. Pass it with ${yellow}--key${reset}\n" >&2
    printf "  2. Set ${yellow}HUNTER_API_KEY${reset} environment variable\n" >&2
    printf "  3. Save it to ${yellow}~/.config/hunter/api_key${reset}\n" >&2
    exit 1
  fi
}
API_KEY=$(get_api_key)
API_BASE="https://api.hunter.io/v2"

print_kv() {
  printf "${bold}%s:${reset} %s\n" "$1" "$2"
}

print_section() {
  printf "\n${bold}%s:${reset}\n" "$1"
}

format_case() {
  echo "$(tr '[:lower:]' '[:upper:]' <<<${1:0:1})${1:1}"
}

make_request() {
  local endpoint="$1"
  local params="$2"
  local url="${API_BASE}/${endpoint}?api_key=${API_KEY}${params}"
  local response=$(curl -s "$url")

  if echo "$response" | jq -e '.errors' >/dev/null 2>&1; then
    error_msg=$(echo "$response" | jq -r '.errors[0].details')
    printf "${red}Error:${reset} Hunter.io API returned: ${red}%s${reset}\n" "$error_msg" >&2
    exit 1
  fi

  echo "$response"
}

