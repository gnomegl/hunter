      echo "  ${yellow}-d, --domain${reset}      Domain to search (alternative to providing as value)"
      echo "  ${yellow}-p, --page${reset}        Page number for results pagination"
      echo "  ${yellow}-s, --size${reset}        Number of results per page"
      echo "  ${yellow}-t, --type${reset}        Filter by email type (personal or generic)"
      echo "  ${yellow}-e, --department${reset}  Filter by department (it, finance, management, sales, etc.)"
      echo "  ${yellow}-n, --seniority${reset}   Filter by seniority (junior, senior, executive, etc.)"
      ;;
    email-finder)
      echo "${bold}Description:${reset} Find email address by name and domain/company"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") email-finder --first-name <name> --last-name <name> --domain <domain>${reset}"
      echo ""
      echo "${bold}Options:${reset}"
      echo "  ${yellow}-f, --first-name${reset}  First name for email-finder"
      echo "  ${yellow}-l, --last-name${reset}   Last name for email-finder"
      echo "  ${yellow}-c, --company${reset}     Company name for email-finder"
      echo "  ${yellow}-d, --domain${reset}      Domain for email-finder (alternative to company)"
      ;;
    verify)
      echo "${bold}Description:${reset} Verify an email address"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") verify <email>${reset}"
      ;;
    count)
      echo "${bold}Description:${reset} Get email count for a domain"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") count <domain>${reset}"
      echo ""
      echo "${bold}Options:${reset}"
      echo "  ${yellow}-d, --domain${reset}      Domain to count (alternative to providing as value)"
      ;;
    account)
      echo "${bold}Description:${reset} Show account information"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") account${reset}"
      ;;
    leads)
      echo "${bold}Description:${reset} List leads"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") leads${reset}"
      echo ""
      echo "${bold}Options:${reset}"
      echo "  ${yellow}-p, --page${reset}        Page number for results pagination"
      echo "  ${yellow}-s, --size${reset}        Number of results per page"
      ;;
    person)
      echo "${bold}Description:${reset} Find detailed information about a person by email"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") person <email>${reset}"
      ;;
    combined)
      echo "${bold}Description:${reset} Find detailed information about a person and their company"
      echo ""
      echo "${bold}Usage:${reset} ${green}$(basename "$0") combined <email>${reset}"
      ;;
    *)
      echo "${red}Error:${reset} Unknown command: ${command}" >&2
      echo ""
      echo "Run ${green}$(basename "$0")${reset} without arguments to see available commands."
      ;;
  esac
  
  echo ""
  echo "${bold}Common Options:${reset}"
  echo "  ${yellow}-k, --key${reset}         Hunter.io API key"

  echo "  ${yellow}-j, --json${reset}        Output raw JSON"
  echo "  ${yellow}-q, --quiet${reset}       Suppress colored output"
}

print_social_media() {
  local data="$1"
  local prefix="$2"
  local section_title="Social Media"

  local twitter=$(echo "$data" | jq -r "$prefix.twitter.handle // \"N/A\"")
  local linkedin=$(echo "$data" | jq -r "$prefix.linkedin.handle // \"N/A\"")
  local github=$(echo "$data" | jq -r "$prefix.github.handle // \"N/A\"")
  local facebook=$(echo "$data" | jq -r "$prefix.facebook.handle // \"N/A\"")

  if [ "$twitter" != "N/A" ] || [ "$linkedin" != "N/A" ] || [ "$github" != "N/A" ] || [ "$facebook" != "N/A" ]; then
    print_section "$section_title"
    [ "$linkedin" != "N/A" ] && printf "  ${cyan}LinkedIn:${reset} ${blue}%s${reset}\n" "$linkedin"
    [ "$twitter" != "N/A" ] && printf "  ${cyan}Twitter:${reset} ${blue}%s${reset}\n" "$twitter"
    [ "$github" != "N/A" ] && printf "  ${cyan}GitHub:${reset} ${blue}%s${reset}\n" "$github"
    [ "$facebook" != "N/A" ] && printf "  ${cyan}Facebook:${reset} ${blue}%s${reset}\n" "$facebook"
    return 0
  fi
  return 1
}

print_sources() {
  local response="$1"
  local email="$2"
  local jq_path="$3"
  local sources_count="$4"

  if [ "$sources_count" -gt 0 ] && [ "$sources_count" != "null" ]; then
    print_section "Sources"
    local jq_query
    if [ -n "$email" ]; then
      jq_query='.data.emails[] | select(.value == "'"$email"'") | .sources[] | "\(.domain)|\(.uri)|\(.extracted_on)|\(.still_on_page // empty)"'
    else
      jq_query="$jq_path"
    fi
    
    echo "$response" | jq -r "$jq_query" |
      while IFS="|" read -r domain uri date still_on_page; do
        printf "  ${yellow}%s${reset} - ${blue}%s${reset} (${magenta}%s${reset})" "$domain" "$uri" "$date"
        if [ "$still_on_page" = "true" ]; then
          printf " ${green}✓${reset}"
        elif [ "$still_on_page" = "false" ]; then
          printf " ${red}✗${reset}"
        fi
        printf "\n"
      done
    return 0
  fi
  return 1
}

print_location() {
  local city="$1"
  local state="$2"
  local country="$3"

  printf "${bold}Location:${reset} "
  if [ "$city" != "N/A" ]; then
    printf "${magenta}%s${reset}" "$city"
    if [ "$state" != "N/A" ] || [ "$country" != "N/A" ]; then
      printf ", "
    fi
  fi
  if [ "$state" != "N/A" ]; then
    printf "${magenta}%s${reset}" "$state"
    if [ "$country" != "N/A" ]; then
      printf ", "
    fi
  fi
  if [ "$country" != "N/A" ]; then
    printf "${magenta}%s${reset}" "$country"
  fi
  printf "\n"
}

format_domain_search() {
  local response="$1"
  local domain=$(echo "$response" | jq -r '.data.domain')
  local pattern=$(echo "$response" | jq -r '.data.pattern // "N/A"')
  local organization=$(echo "$response" | jq -r '.data.organization // "N/A"')
  local description=$(echo "$response" | jq -r '.data.description // "N/A"')
  local industry=$(echo "$response" | jq -r '.data.industry // "N/A"')
  local country=$(echo "$response" | jq -r '.data.country // "N/A"')
  local state=$(echo "$response" | jq -r '.data.state // "N/A"')
  local city=$(echo "$response" | jq -r '.data.city // "N/A"')
  local postal_code=$(echo "$response" | jq -r '.data.postal_code // "N/A"')
  local street=$(echo "$response" | jq -r '.data.street // "N/A"')
  local headcount=$(echo "$response" | jq -r '.data.headcount // "N/A"')
  local company_type=$(echo "$response" | jq -r '.data.company_type // "N/A"')
  local disposable=$(echo "$response" | jq -r '.data.disposable // false')
  local webmail=$(echo "$response" | jq -r '.data.webmail // false')
  local accept_all=$(echo "$response" | jq -r '.data.accept_all // false')
  local email_count=$(echo "$response" | jq -r '.data.emails | length')
  local total_results=$(echo "$response" | jq -r '.meta.results')
  local limit=$(echo "$response" | jq -r '.meta.limit')
  local offset=$(echo "$response" | jq -r '.meta.offset')

  print_kv "Domain" "${green}${domain}${reset}"
  print_kv "Organization" "${blue}${organization}${reset}"
  [ "$description" != "N/A" ] && print_kv "Description" "$description"
  [ "$industry" != "N/A" ] && print_kv "Industry" "${cyan}${industry}${reset}"

  if [ "$country" != "N/A" ] || [ "$state" != "N/A" ] || [ "$city" != "N/A" ] || [ "$postal_code" != "N/A" ] || [ "$street" != "N/A" ]; then
    print_section "Address"
    [ "$street" != "N/A" ] && printf "  ${cyan}Street:${reset} ${magenta}%s${reset}\n" "$street"
    [ "$city" != "N/A" ] || [ "$state" != "N/A" ] || [ "$country" != "N/A" ] && print_location "$city" "$state" "$country"
    [ "$postal_code" != "N/A" ] && printf "  ${cyan}Postal Code:${reset} ${magenta}%s${reset}\n" "$postal_code"
  fi

  [ "$headcount" != "N/A" ] && print_kv "Headcount" "${yellow}${headcount}${reset}"
  [ "$company_type" != "N/A" ] && print_kv "Company Type" "${cyan}${company_type}${reset}"

  print_section "Email Configuration"
  print_kv "  Pattern" "${magenta}${pattern}${reset}"
  printf "  ${cyan}Domain Properties:${reset} "
  if [ "$disposable" = "true" ]; then
    printf "${red}Disposable${reset}, "
  else
    printf "${green}Not Disposable${reset}, "
  fi
  if [ "$webmail" = "true" ]; then
    printf "${yellow}Webmail${reset}, "
  else
    printf "${green}Corporate${reset}, "
  fi
  if [ "$accept_all" = "true" ]; then
    printf "${yellow}Accepts All Email${reset}\n"
  else
    printf "${green}Validates Email${reset}\n"
  fi

  printf "${bold}Found:${reset} ${yellow}%s${reset} of ${yellow}%s${reset} total email addresses (page %s, limit %s)\n" \
    "$email_count" "$total_results" "$(((offset / limit) + 1))" "$limit"

  local twitter=$(echo "$response" | jq -r '.data.twitter // "N/A"')
  local facebook=$(echo "$response" | jq -r '.data.facebook // "N/A"')
  local linkedin=$(echo "$response" | jq -r '.data.linkedin // "N/A"')
  local instagram=$(echo "$response" | jq -r '.data.instagram // "N/A"')
  local youtube=$(echo "$response" | jq -r '.data.youtube // "N/A"')

  if [ "$twitter" != "N/A" ] || [ "$facebook" != "N/A" ] || [ "$linkedin" != "N/A" ] || [ "$instagram" != "N/A" ] || [ "$youtube" != "N/A" ]; then
    print_section "Social Media"
    [ "$linkedin" != "N/A" ] && printf "  ${cyan}LinkedIn:${reset} ${blue}%s${reset}\n" "$linkedin"
    [ "$twitter" != "N/A" ] && printf "  ${cyan}Twitter:${reset} ${blue}%s${reset}\n" "$twitter"
    [ "$facebook" != "N/A" ] && printf "  ${cyan}Facebook:${reset} ${blue}%s${reset}\n" "$facebook"
    [ "$instagram" != "N/A" ] && printf "  ${cyan}Instagram:${reset} ${blue}%s${reset}\n" "$instagram"
    [ "$youtube" != "N/A" ] && printf "  ${cyan}YouTube:${reset} ${blue}%s${reset}\n" "$youtube"
  fi

  local tech_count=$(echo "$response" | jq -r '.data.technologies | length // 0')
  if [ "$tech_count" -gt 0 ]; then
    print_section "Technologies"
    printf "  "
    echo "$response" | jq -r '.data.technologies[]' | sort | while read -r tech; do
      printf "${yellow}%s${reset}, " "$tech"
    done
    printf "\b\b \n"
  fi

  local linked_domains_count=$(echo "$response" | jq -r '.data.linked_domains | length // 0')
  if [ "$linked_domains_count" -gt 0 ]; then
    print_section "Linked Domains"
    echo "$response" | jq -r '.data.linked_domains[]' | while read -r linked_domain; do
      printf "  ${green}%s${reset}\n" "$linked_domain"
    done
  fi

  print_section "Email Addresses"
  echo "$response" | jq -r '.data.emails[] | "\(.value)|\(.first_name)|\(.last_name)|\(.position // "N/A")|\(.department // "N/A")|\(.seniority // "N/A")|\(.confidence)|\(.verification.status // "unknown")|\(.linkedin // "N/A")|\(.twitter // "N/A")|\(.phone_number // "N/A")|\(.type // "unknown")|\(.sources | length // 0)"' |
    while IFS="|" read -r email first last position department seniority confidence verification linkedin_url twitter_handle phone email_type sources_count; do
      printf "${bold}* ${green}%s${reset} (${yellow}%s%%${reset} confidence, ${cyan}%s${reset}, type: ${magenta}%s${reset})\n" \
        "$email" "$confidence" "$verification" "$email_type"
      printf "  ${blue}%s %s${reset}" "$first" "$last"
      [ "$position" != "N/A" ] && printf " - ${magenta}%s${reset}" "$position"
      printf "\n"

      if [ "$department" != "N/A" ] || [ "$seniority" != "N/A" ]; then
        printf "  "
        if [ "$department" != "N/A" ]; then
          printf "${cyan}Department:${reset} ${yellow}%s${reset}" "$(format_case "$department")"
        fi
        if [ "$seniority" != "N/A" ]; then
          [ "$department" != "N/A" ] && printf ", "
          printf "${cyan}Seniority:${reset} ${yellow}%s${reset}" "$(format_case "$seniority")"
        fi
        printf "\n"
      fi

      local has_contact=0
      if [ "$linkedin_url" != "N/A" ] || [ "$twitter_handle" != "N/A" ] || [ "$phone" != "N/A" ]; then
        printf "  ${cyan}Contact:${reset} "
        if [ "$linkedin_url" != "N/A" ]; then
          printf "${blue}LinkedIn: %s${reset}" "$linkedin_url"
          has_contact=1
        fi
        if [ "$twitter_handle" != "N/A" ]; then
          [ "$has_contact" -eq 1 ] && printf ", "
          printf "${blue}Twitter: @%s${reset}" "$twitter_handle"
          has_contact=1
        fi
        if [ "$phone" != "N/A" ]; then
          [ "$has_contact" -eq 1 ] && printf ", "
          printf "${blue}Phone: %s${reset}" "$phone"
        fi
        printf "\n"
      fi

      print_sources "$response" "$email" "" "$sources_count"

      printf "  ${bold}───────────────────────────────────────${reset}\n"
    done
}

format_email_finder() {
  local response="$1"
  local email=$(echo "$response" | jq -r '.data.email')
  local score=$(echo "$response" | jq -r '.data.score')
  local first_name=$(echo "$response" | jq -r '.data.first_name')
  local last_name=$(echo "$response" | jq -r '.data.last_name')
  local position=$(echo "$response" | jq -r '.data.position // "N/A"')
  local company=$(echo "$response" | jq -r '.data.company // "N/A"')
  local department=$(echo "$response" | jq -r '.data.department // "N/A"')
  local seniority=$(echo "$response" | jq -r '.data.seniority // "N/A"')
  local verification=$(echo "$response" | jq -r '.data.verification.status // "unknown"')
  local linkedin=$(echo "$response" | jq -r '.data.linkedin // "N/A"')
  local twitter=$(echo "$response" | jq -r '.data.twitter // "N/A"')
  local phone=$(echo "$response" | jq -r '.data.phone_number // "N/A"')

  printf "${bold}Email Found:${reset} ${green}%s${reset} (${yellow}%s%%${reset} confidence, ${cyan}%s${reset})\n" "$email" "$score" "$verification"
  print_kv "Name" "${blue}${first_name} ${last_name}${reset}"
  [ "$position" != "N/A" ] && print_kv "Position" "${magenta}${position}${reset}"
  [ "$company" != "N/A" ] && print_kv "Company" "${magenta}${company}${reset}"

  if [ "$department" != "N/A" ] || [ "$seniority" != "N/A" ]; then
    if [ "$department" != "N/A" ]; then
      printf "${bold}Department:${reset} ${yellow}%s${reset}" "$(format_case "$department")"
    fi
    if [ "$seniority" != "N/A" ]; then
      if [ "$department" != "N/A" ]; then
        printf ", "
      else
        printf "${bold}Seniority:${reset} "
      fi
      printf "${yellow}%s${reset}\n" "$(format_case "$seniority")"
    else
      printf "\n"
    fi
  fi

  local has_contact=0
  if [ "$linkedin" != "N/A" ] || [ "$twitter" != "N/A" ] || [ "$phone" != "N/A" ]; then
    printf "${bold}Contact:${reset} "
    if [ "$linkedin" != "N/A" ]; then
      printf "${blue}%s${reset}" "$linkedin"
      has_contact=1
    fi
    if [ "$twitter" != "N/A" ]; then
      [ "$has_contact" -eq 1 ] && printf "\n         "
      printf "${blue}%s${reset}" "$twitter"
      has_contact=1
    fi
    if [ "$phone" != "N/A" ]; then
      [ "$has_contact" -eq 1 ] && printf "\n         "
      printf "${blue}%s${reset}" "$phone"
    fi
    printf "\n"
  fi

  local sources_count=$(echo "$response" | jq -r '.data.sources | length')
  print_sources "$response" "" '.data.sources[] | "\(.domain)|\(.uri)|\(.extracted_on)|\(.still_on_page // "unknown")"' "$sources_count"
}

format_email_verification() {
  local response="$1"
  local email=$(echo "$response" | jq -r '.data.email')
  local result=$(echo "$response" | jq -r '.data.result')
  local score=$(echo "$response" | jq -r '.data.score')
  local status=$(echo "$response" | jq -r '.data.status')

  print_kv "Email" "${green}${email}${reset}"
  print_kv "Result" "${blue}${result}${reset}"
  print_kv "Score" "${yellow}${score}%${reset}"
  print_kv "Status" "${cyan}${status}${reset}"
  print_section "Checks"

  echo "$response" | jq -r '.data | "\(.regexp)|\(.gibberish)|\(.disposable)|\(.webmail)|\(.mx_records)|\(.smtp_server)|\(.smtp_check)|\(.accept_all)|\(.block)"' |
    while IFS="|" read -r regexp gibberish disposable webmail mx smtp_server smtp_check accept_all block; do
      local pass="${green}Pass${reset}"
      local fail="${red}Fail${reset}"
      local warn="${yellow}Warning${reset}"
      printf "  ${cyan}Regexp:${reset} %s\n" "$([ "$regexp" = "true" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}Gibberish:${reset} %s\n" "$([ "$gibberish" = "false" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}Disposable:${reset} %s\n" "$([ "$disposable" = "false" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}Webmail:${reset} %s\n" "$([ "$webmail" = "false" ] && echo "$pass" || echo "${yellow}Webmail${reset}")"
      printf "  ${cyan}MX Records:${reset} %s\n" "$([ "$mx" = "true" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}SMTP Server:${reset} %s\n" "$([ "$smtp_server" = "true" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}SMTP Check:${reset} %s\n" "$([ "$smtp_check" = "true" ] && echo "$pass" || echo "$fail")"
      printf "  ${cyan}Accept All:${reset} %s\n" "$([ "$accept_all" = "false" ] && echo "$pass" || echo "$warn")"
      printf "  ${cyan}Block:${reset} %s\n" "$([ "$block" = "false" ] && echo "$pass" || echo "$fail")"
    done
}

format_email_count() {
  local response="$1"
  local total=$(echo "$response" | jq -r '.data.total')
  local personal=$(echo "$response" | jq -r '.data.personal_emails')
  local generic=$(echo "$response" | jq -r '.data.generic_emails')

  print_section "Email Count"
  printf "  ${bold}Total:${reset} ${green}%s${reset}\n" "$total"
