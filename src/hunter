if [ -z "$argc_command" ]; then
  show_help
  exit 0
fi

[ -z "$argc_page" ] && argc_page="1"
[ -z "$argc_size" ] && argc_size="100"

if [ "$argc_command" = "help" ]; then
  if [ -z "$argc_value" ]; then
    show_help
  else
    show_help "$argc_value"
  fi
  exit 0
fi

case "$argc_command" in
domain)
  if [ -z "$argc_value" ] && [ -z "$argc_domain" ]; then
    echo "${red}Error:${reset} Domain name is required." >&2
    exit 1
  fi
  domain="${argc_value:-$argc_domain}"
  params="&domain=${domain}&limit=${argc_size}&offset=$(((argc_page - 1) * argc_size))"
  [ -n "$argc_department" ] && params="${params}&department=${argc_department}"
  [ -n "$argc_seniority" ] && params="${params}&seniority=${argc_seniority}"
  [ -n "$argc_type" ] && params="${params}&type=${argc_type}"
  response=$(make_request "domain-search" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_domain_search "$response"
  ;;

person)
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Email address is required." >&2
    exit 1
  fi
  params="&email=${argc_value}"
  response=$(make_request "people/find" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_person "$response"
  ;;

combined)
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Email address is required." >&2
    exit 1
  fi
  params="&email=${argc_value}"
  response=$(make_request "combined/find" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_combined "$response"
  ;;

email-finder)
  if [ -z "$argc_first_name" ] || [ -z "$argc_last_name" ] || ([ -z "$argc_domain" ] && [ -z "$argc_company" ] && [ -z "$argc_value" ]); then
    echo "${red}Error:${reset} First name, last name, and domain/company are required." >&2
    exit 1
  fi
  domain="${argc_domain:-$argc_value}"
  params="&first_name=${argc_first_name}&last_name=${argc_last_name}"
  [ -n "$domain" ] && params="${params}&domain=${domain}" || params="${params}&company=${argc_company}"
  response=$(make_request "email-finder" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_email_finder "$response"
  ;;

verify)
  if [ -z "$argc_value" ]; then
    echo "${red}Error:${reset} Email address is required." >&2
    exit 1
  fi
  params="&email=${argc_value}"
  response=$(make_request "email-verifier" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_email_verification "$response"
  ;;

count)
  if [ -z "$argc_value" ] && [ -z "$argc_domain" ]; then
    echo "${red}Error:${reset} Domain name is required." >&2
    exit 1
  fi
  domain="${argc_value:-$argc_domain}"
  params="&domain=${domain}"
  response=$(make_request "email-count" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_email_count "$response"
  ;;

account)
  response=$(make_request "account" "")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_account_info "$response"
  ;;

leads)
  params="&limit=${argc_size}&offset=$(((argc_page - 1) * argc_size))"
  response=$(make_request "leads" "$params")
  [ "$argc_json" = 1 ] && echo "$response" | jq || format_leads "$response"
  ;;

*)
  echo "${red}Error:${reset} Unknown command: ${argc_command}" >&2
  show_help
  exit 1
  ;;
esac

if [ -n "$response" ]; then
  remaining=$(echo "$response" | jq -r '.meta.remaining_calls // "N/A"')
  if [ "$remaining" != "N/A" ] && [ "$argc_json" != 1 ]; then
    printf "\n${bold}${yellow}API Rate Limit:${reset} ${remaining} requests remaining\n"
  fi
fi
